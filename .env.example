# Create a bot with @BotFather. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID; comma-separated IDs are supported.
# Send /start to the running bot to see your ID if access is denied.
ALLOWED_USER_IDS=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180
DATABASE_PATH=data/agent.sqlite3

# Optional SMTP sending (TLS); use an app password where required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# Optional inbox reading (IMAP over SSL).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
